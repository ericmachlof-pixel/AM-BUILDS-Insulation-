<header class="site-header" id="siteHeader" role="banner">
  <div class="site-header__inner">
    <!-- Logo -->
    <a href="/" class="site-header__logo" aria-label="Insulara — Home">
      <span class="logo-am">IN</span><span class="logo-builders">SULARA</span>
    </a>

    <!-- Nav -->
    <nav class="site-header__nav" role="navigation" aria-label="Main navigation">
      <ul class="nav-list">
        <li><a href="/" class="nav-link<%= page === 'home' ? ' is-active' : '' %>">Home</a></li>
        <li><a href="/services" class="nav-link<%= page === 'services' ? ' is-active' : '' %>">Services</a></li>
        <li class="nav-dropdown<%= ['service-areas','los-angeles','ventura-county','orange-county','san-bernardino'].includes(page) ? ' is-active' : '' %>">
          <a href="/service-areas" class="nav-link nav-dropdown__toggle<%= ['service-areas','los-angeles','ventura-county','orange-county','san-bernardino'].includes(page) ? ' is-active' : '' %>">
            Service Areas
            <svg class="nav-dropdown__caret" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
          </a>
          <ul class="nav-dropdown__menu" role="menu">
            <li role="none"><a href="/service-areas" class="nav-dropdown__item<%= page === 'service-areas' ? ' is-active' : '' %>" role="menuitem">All Service Areas</a></li>
            <li role="none" class="nav-dropdown__divider" aria-hidden="true"></li>
            <li role="none"><a href="/los-angeles" class="nav-dropdown__item<%= page === 'los-angeles' ? ' is-active' : '' %>" role="menuitem">Los Angeles</a></li>
            <li role="none"><a href="/ventura-county" class="nav-dropdown__item<%= page === 'ventura-county' ? ' is-active' : '' %>" role="menuitem">Ventura County</a></li>
            <li role="none"><a href="/orange-county" class="nav-dropdown__item<%= page === 'orange-county' ? ' is-active' : '' %>" role="menuitem">Orange County</a></li>
            <li role="none"><a href="/san-bernardino" class="nav-dropdown__item<%= page === 'san-bernardino' ? ' is-active' : '' %>" role="menuitem">San Bernardino</a></li>
          </ul>
        </li>
        <li><a href="/about" class="nav-link<%= page === 'about' ? ' is-active' : '' %>">About</a></li>
        <li><a href="/contact" class="nav-link<%= page === 'contact' ? ' is-active' : '' %>">Contact</a></li>
      </ul>
    </nav>

    <!-- CTA -->
    <a href="/contact" class="btn btn--nav">Free Inspection</a>

    <!-- Mobile hamburger -->
    <button class="hamburger" id="hamburger" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobileMenu">
      <span class="hamburger__line"></span>
      <span class="hamburger__line"></span>
      <span class="hamburger__line"></span>
    </button>
  </div>

  <!-- Mobile menu -->
  <div class="mobile-menu" id="mobileMenu" role="dialog" aria-modal="true" aria-label="Mobile navigation">
    <nav>
      <ul class="mobile-menu__list">
        <li><a href="/" class="mobile-menu__link">Home</a></li>
        <li><a href="/services" class="mobile-menu__link">Services</a></li>
        <li>
          <a href="/service-areas" class="mobile-menu__link">Service Areas</a>
          <ul class="mobile-menu__sub">
            <li><a href="/los-angeles" class="mobile-menu__link mobile-menu__link--sub">→ Los Angeles</a></li>
            <li><a href="/ventura-county" class="mobile-menu__link mobile-menu__link--sub">→ Ventura County</a></li>
            <li><a href="/orange-county" class="mobile-menu__link mobile-menu__link--sub">→ Orange County</a></li>
            <li><a href="/san-bernardino" class="mobile-menu__link mobile-menu__link--sub">→ San Bernardino</a></li>
          </ul>
        </li>
        <li><a href="/about" class="mobile-menu__link">About</a></li>
        <li><a href="/contact" class="mobile-menu__link">Contact</a></li>
      </ul>
      <a href="/contact" class="btn btn--orange btn--lg">Get Free Inspection</a>
    </nav>
  </div>
</header>
