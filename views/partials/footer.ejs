<footer class="site-footer" role="contentinfo">
  <!-- Noise overlay -->
  <div class="noise" aria-hidden="true"></div>

  <!-- Service Areas Banner -->
  <div class="footer-areas">
    <div class="container">
      <div class="footer-areas__header">
        <span class="label-tag label-tag--light">SERVICE AREAS</span>
        <h2 class="footer-areas__title">Areas we serve.</h2>
      </div>
      <div class="footer-areas__grid">
        <a href="/los-angeles" class="footer-area-card">
          <div class="footer-area-card__icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <div class="footer-area-card__body">
            <h3 class="footer-area-card__name">Los Angeles</h3>
            <p class="footer-area-card__desc">Attic insulation, rat proofing &amp; decontamination across LA County.</p>
          </div>
          <span class="footer-area-card__arrow" aria-hidden="true">→</span>
        </a>
        <a href="/ventura-county" class="footer-area-card">
          <div class="footer-area-card__icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <div class="footer-area-card__body">
            <h3 class="footer-area-card__name">Ventura County</h3>
            <p class="footer-area-card__desc">Serving Simi Valley, Thousand Oaks, Oxnard, Ventura, Camarillo &amp; Ojai.</p>
          </div>
          <span class="footer-area-card__arrow" aria-hidden="true">→</span>
        </a>
        <a href="/orange-county" class="footer-area-card">
          <div class="footer-area-card__icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <div class="footer-area-card__body">
            <h3 class="footer-area-card__name">Orange County</h3>
            <p class="footer-area-card__desc">Irvine, Anaheim, Mission Viejo, Yorba Linda, Laguna Niguel &amp; more.</p>
          </div>
          <span class="footer-area-card__arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>

