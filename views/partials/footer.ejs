          <h3 class="footer-col-head">Services</h3>
          <ul class="footer-links">
            <li><a href="/services#attic">Attic Insulation</a></li>
            <li><a href="/services#wall">Wall Insulation</a></li>
            <li><a href="/services#crawlspace">Crawlspace Insulation</a></li>
            <li><a href="/services#spray-foam">Spray Foam</a></li>
            <li><a href="/services#rat-proofing">Rat Proofing</a></li>
            <li><a href="/services#decontamination">Decontamination</a></li>
          </ul>
        </div>

        <!-- Company col -->
        <div class="site-footer__col">
          <h3 class="footer-col-head">Company</h3>
          <ul class="footer-links">
            <li><a href="/about">About Us</a></li>
            <li><a href="/about#team">Our Team</a></li>
            <li><a href="/about#certifications">Certifications</a></li>
            <li><a href="/contact">Contact</a></li>
          </ul>
        </div>

        <!-- Contact col -->
        <div class="site-footer__col">
          <h3 class="footer-col-head">Contact</h3>
          <ul class="footer-links footer-links--contact">
            <li>
              <a href="tel:<%= siteData.phone.replace(/\D/g, '') %>"><%= siteData.phone %></a>
            </li>
            <li>
              <a href="mailto:<%= siteData.email %>"><%= siteData.email %></a>
            </li>
            <li><span><%= siteData.address %></span></li>
          </ul>
          <a href="/contact" class="btn btn--orange" style="margin-top:1.5rem;">Free Inspection</a>
        </div>

